#!/usr/bin/env bash
set -euo pipefail

# Resolve plugin root directory
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  PLUGIN_ROOT="$CLAUDE_PLUGIN_ROOT"
elif [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  PLUGIN_ROOT="$CURSOR_PLUGIN_ROOT"
else
  PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi

SKILL_FILE="$PLUGIN_ROOT/skills/using-harnessed/SKILL.md"

if [ ! -f "$SKILL_FILE" ]; then
  printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "Harnessed plugin: meta-skill not found."}}\n'
  exit 0
fi

SKILL_CONTENT=$(<"$SKILL_FILE")

# JSON-escape the content (python3 preferred; perl fallback for systems without python3)
ESCAPED=$(printf '%s' "$SKILL_CONTENT" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' 2>/dev/null \
  || printf '%s' "$SKILL_CONTENT" | perl -e '
    use JSON::PP;
    local $/; my $s = <STDIN>;
    print JSON::PP->new->encode($s);
  ' 2>/dev/null \
  || printf '%s' "$SKILL_CONTENT" | perl -0777 -pe '
    s/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r//g; s/\n/\\n/g;
    $_ = "\"$_\"";
  ')

# Validate that ESCAPED is valid JSON string (non-empty, starts and ends with quote)
if [ -z "$ESCAPED" ] || ! printf '%s' "$ESCAPED" | grep -q '^".*"$'; then
  printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "Harnessed plugin: failed to encode meta-skill content."}}\n'
  exit 0
fi

# Output in the format expected by Claude Code or Cursor
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context": %s}\n' "$ESCAPED"
else
  printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": %s}}\n' "$ESCAPED"
fi
