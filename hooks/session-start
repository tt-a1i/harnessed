#!/usr/bin/env bash
set -euo pipefail

# Resolve plugin root directory
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  PLUGIN_ROOT="$CLAUDE_PLUGIN_ROOT"
elif [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  PLUGIN_ROOT="$CURSOR_PLUGIN_ROOT"
else
  PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi

SKILL_FILE="$PLUGIN_ROOT/skills/using-harnessed/SKILL.md"

if [ ! -f "$SKILL_FILE" ]; then
  echo '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "Harnessed plugin: meta-skill not found."}}'
  exit 0
fi

SKILL_CONTENT=$(cat "$SKILL_FILE")

# JSON-escape the content
ESCAPED=$(printf '%s' "$SKILL_CONTENT" | python3 -c '
import sys, json
print(json.dumps(sys.stdin.read()))
' 2>/dev/null || printf '%s' "$SKILL_CONTENT" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/$/\\n/' | tr -d '\n' | sed 's/^/"/; s/$/"/')

# Validate that ESCAPED is valid JSON string (non-empty, starts and ends with quote)
if [ -z "$ESCAPED" ] || ! printf '%s' "$ESCAPED" | grep -q '^".*"$'; then
  echo '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "Harnessed plugin: failed to encode meta-skill content."}}'
  exit 0
fi

# Output in the format expected by Claude Code or Cursor
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  cat <<EOF
{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ${ESCAPED}}}
EOF
elif [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  cat <<EOF
{"additional_context": ${ESCAPED}}
EOF
else
  cat <<EOF
{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ${ESCAPED}}}
EOF
fi
